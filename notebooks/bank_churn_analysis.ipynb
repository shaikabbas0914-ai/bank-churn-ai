 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bank Customer Churn - Exploratory Data Analysis (EDA)\n",
    "\n",
    "This notebook contains the exploratory analysis of the Bank Customer Churn dataset (`Churn_Modelling.csv`). We will investigate relationships between customer demographics, account statuses, and the target variable `Exited`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set style\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams[\"figure.figsize\"] = (10, 6)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load the Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv('../data/Churn_Modelling.csv')\n",
    "print(f\"Dataset shape: {df.shape}\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Check for Missing Values and Info"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.info()\n",
    "print(\"\\nMissing values:\")\n",
    "print(df.isnull().sum())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Describe Numeric Fields"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df.describe().T"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Churn Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "churn_counts = df['Exited'].value_counts(normalize=True) * 100\n",
    "print(f\"Stayed (0): {churn_counts[0]:.2f}%\")\n",
    "print(f\"Churned (1): {churn_counts[1]:.2f}%\")\n",
    "\n",
    "sns.countplot(x='Exited', data=df)\n",
    "plt.title('Customer Churn Distribution')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Visualizing Demographics vs Churn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Churn by Gender\n",
    "sns.countplot(x='Gender', hue='Exited', data=df)\n",
    "plt.title('Churn by Gender')\n",
    "plt.show()\n",
    "\n",
    "# Churn by Geography\n",
    "sns.countplot(x='Geography', hue='Exited', data=df)\n",
    "plt.title('Churn by Geography')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Visualizing Continuous Variables vs Churn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Age Distribution\n",
    "sns.histplot(x='Age', hue='Exited', data=df, kde=True, multiple='stack')\n",
    "plt.title('Age Distribution by Churn Status')\n",
    "plt.show()\n",
    "\n",
    "# Balance Distribution\n",
    "sns.histplot(x='Balance', hue='Exited', data=df, kde=True, multiple='stack')\n",
    "plt.title('Balance Distribution by Churn Status')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Account Attributes vs Churn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Active Member status\n",
    "sns.countplot(x='IsActiveMember', hue='Exited', data=df)\n",
    "plt.title('Churn by Active Member Status')\n",
    "plt.show()\n",
    "\n",
    "# Number of Products used\n",
    "sns.countplot(x='NumOfProducts', hue='Exited', data=df)\n",
    "plt.title('Churn by Number of Products')\n",
    "plt.show()"
   ]
  }
 ],
